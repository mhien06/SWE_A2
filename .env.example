# Local development samples only. Do not use for production.
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite_local
POSTGRES_DB=brewlite_dev
POSTGRES_PORT=5433
WEB_PORT=3000
API_PORT=3001
# Host-side Prisma/CLI only; Compose supplies postgres:5432 to the API.
DATABASE_URL=postgresql://brewlite:brewlite_local@localhost:5433/brewlite_dev?schema=public

# Web / CORS configuration samples
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
API_INTERNAL_URL=http://api:3001

# Auth & business TTL samples (Task 5.1+ — placeholder values only, never commit real secrets)
JWT_SECRET=replace-with-local-dev-jwt-secret
JWT_EXPIRES_IN=1d
ORDER_PENDING_TTL_MINUTES=15
PAYMENT_ATTEMPT_TTL_MINUTES=15

# VNPay Sandbox samples (Task 5.1+ — placeholder values only)
VNP_TMN_CODE=DEMO_TMN_CODE
VNP_HASH_SECRET=replace-with-sandbox-hash-secret
VNP_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNP_RETURN_URL=http://localhost:3000/checkout/return
